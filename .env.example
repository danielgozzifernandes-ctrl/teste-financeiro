# B3 Stock Recommender — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env.

# ─── Telegram ────────────────────────────────────────────────────────────────
# Token do bot gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwXYZ

# ID do canal ou grupo onde o relatório será enviado.
# Para canais públicos: @nome_do_canal
# Para canais privados/grupos: número negativo (ex: -1001234567890)
# Para você mesmo: seu user ID numérico (sem sinal negativo)
TELEGRAM_CHAT_ID=-1001234567890

# ─── brapi.dev (opcional) ─────────────────────────────────────────────────────
# Token da API do brapi.dev para aumentar o rate limit.
# Sem token: 10 req/min (gratuito). Com token: limite maior.
# Cadastro gratuito em: https://brapi.dev
BRAPI_TOKEN=
